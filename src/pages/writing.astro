---
import Layout from '../layouts/Layout.astro';
import { frontmatter as writing } from '../content/sections/writing.md';

interface Post {
  title: string;
  excerpt: string;
  date: string;
  readingTime: string;
  href: string;
  featured: boolean;
}

const posts = writing.posts as Post[];
const featuredPost = posts.find((post) => post.featured) ?? posts[0];
const recentPosts = posts.filter((post) => post !== featuredPost);
---

<Layout title="Writing | Charles Leung" description="Writing by Charles Leung on applied AI, data systems, product delivery, and engineering leadership.">
  <main class="py-10 md:py-16">
    <header class="reveal border-b-2 border-ink pb-8 dark:border-dark-ink md:pb-12">
      <div class="mb-5 flex items-center gap-3 font-mono text-xs uppercase tracking-widest">
        <span class="text-accent">Field notes</span>
        <span aria-hidden="true" class="text-hairline dark:text-dark-hairline">/</span>
        <span lang="zh-Hant" class="text-neutral-500">札記</span>
      </div>
      <h1 class="font-serif text-7xl leading-none sm:text-8xl md:text-9xl">Writing.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300 md:text-xl">{writing.subtitle}. Essays about the technical and organizational decisions behind enterprise software.</p>
    </header>

    <section class="reveal grid grid-cols-1 gap-12 pb-8 pt-12 md:grid-cols-12 md:gap-12 md:pb-10 md:pt-16">
      <div class="md:col-span-3">
        <p class="font-mono text-xs uppercase tracking-widest text-accent">Featured essay</p>
      </div>
      <article class="md:col-span-9">
        <div class="mb-5 flex gap-3 font-mono text-xs uppercase tracking-widest text-neutral-500">
          <span>{featuredPost.date}</span>
          <span>{featuredPost.readingTime}</span>
        </div>
        <h2 class="max-w-4xl font-serif text-5xl leading-none md:text-7xl">{featuredPost.title}</h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">{featuredPost.excerpt}</p>
        {featuredPost.href && (
          <a href={featuredPost.href} target="_blank" rel="noopener noreferrer" class="mt-7 inline-block font-mono text-sm text-accent hover:underline">Read essay ↗</a>
        )}
      </article>
    </section>

    <section class="reveal pb-8 pt-2 md:pb-10 md:pt-4">
      <div class="mb-4 flex items-baseline justify-between border-b border-hairline pb-3 dark:border-dark-hairline">
        <h2 class="font-mono text-xs uppercase tracking-widest text-accent">Archive</h2>
        {writing.publicationUrl && (
          <a href={writing.publicationUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-xs uppercase tracking-widest text-accent hover:underline">Substack ↗</a>
        )}
      </div>
      <div class="divide-y divide-hairline dark:divide-dark-hairline">
        {recentPosts.map((post, index) => (
          <article class="reveal grid grid-cols-1 gap-4 py-6 md:grid-cols-12 md:gap-8">
            <div class="font-mono text-xs uppercase tracking-widest text-neutral-500 md:col-span-2">{String(index + 1).padStart(2, '0')} / {post.date}</div>
            <h3 class="font-serif text-2xl leading-tight md:col-span-5 md:text-3xl">{post.title}</h3>
            <div class="md:col-span-4">
              <p class="text-base leading-relaxed text-neutral-600 dark:text-neutral-300">{post.excerpt}</p>
              <p class="mt-3 font-mono text-xs uppercase tracking-widest text-neutral-500">{post.readingTime}</p>
            </div>
            <div class="md:col-span-1 md:text-right">
              {post.href && <a href={post.href} target="_blank" rel="noopener noreferrer" class="font-mono text-sm text-accent hover:underline">Read ↗</a>}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
