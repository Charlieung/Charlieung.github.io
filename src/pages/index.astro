---
import Layout from '../layouts/Layout.astro';
import { Content as Opening, frontmatter as opening } from '../content/sections/opening.md';
import { frontmatter as ledger } from '../content/sections/ledger.md';
import { Content as EvolutionIQ, frontmatter as evolutionIQ } from '../content/sections/ledger/evolutioniq.md';
import { Content as Inference, frontmatter as inference } from '../content/sections/ledger/inference.md';
import { Content as Operations, frontmatter as operations } from '../content/sections/ledger/operations.md';
---

<Layout title="Charles Leung | Applied AI Engineering Leader" description="Charles Leung is a founding engineer turned engineering manager who leads applied AI products from technical foundation through enterprise delivery.">
  <main class="py-8 md:py-16">
    {/* Masthead & Opening Manifesto */}
    <section class="reveal grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 mb-12 md:mb-16 lg:mb-20">
      <div class="md:col-span-8 lg:col-span-9 grid gap-4 md:grid-cols-[2.5rem_minmax(0,1fr)] md:gap-6 content-start">
        <span lang="zh-Hant" class="chinese-name text-accent text-2xl md:text-3xl">{opening.chineseName}</span>
        <div class="flex min-w-0 flex-col justify-center">
          <h1 class="font-serif leading-[0.95] mb-6">
            <span class="block text-5xl sm:text-6xl md:text-7xl lg:text-8xl">{opening.headline}</span>
            <span class="block mt-4 text-accent italic text-[1.75rem] sm:text-4xl md:text-5xl lg:text-6xl">{opening.emphasis}</span>
          </h1>
          <div class="text-base md:text-xl font-medium max-w-3xl leading-snug"><Opening /></div>
          <a href="/resume/" class="self-start mt-6 border border-hairline dark:border-dark-hairline px-4 py-2 font-mono text-sm hover:bg-ink hover:text-paper dark:hover:bg-dark-ink dark:hover:text-dark-paper transition-colors duration-200">View resume</a>
        </div>
      </div>

      {/* Executive Proofline / Marginalia */}
      <aside class="order-3 md:order-none md:col-span-4 lg:col-span-3 border-l border-hairline dark:border-dark-hairline pl-6 md:pl-8 md:py-2 md:self-start">
        <figure class="relative ml-auto max-w-40 grayscale transition-all duration-700 ease-in-out hover:grayscale-0 md:ml-0 md:max-w-none">
          <img
            src="/images/profile.jpg"
            alt="Portrait of Charles Leung"
            class="aspect-[4/5] w-full object-cover object-[center_30%] border border-hairline dark:border-dark-hairline md:aspect-auto"
            loading="eager"
          />
          <figcaption class="mt-2 hidden text-right font-mono text-[0.65rem] uppercase tracking-widest text-neutral-500 md:block">
            Fig 1. — The Author
          </figcaption>
        </figure>
      </aside>
      <div class="order-2 grid grid-cols-1 gap-3 border-t border-hairline pt-5 font-sans text-sm dark:border-dark-hairline md:order-none md:col-span-12 md:grid-cols-3 md:gap-8">
        <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-3 md:block">
          <h3 class="text-xs font-bold uppercase tracking-wider text-accent md:mb-2">Leadership</h3>
          <p class="leading-relaxed">{opening.leadership}</p>
        </div>
        <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-3 md:block">
          <h3 class="text-xs font-bold uppercase tracking-wider text-accent md:mb-2">Delivery</h3>
          <p class="leading-relaxed">{opening.delivery}</p>
        </div>
        <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-3 md:block">
          <h3 class="text-xs font-bold uppercase tracking-wider text-accent md:mb-2">Impact</h3>
          <p class="leading-relaxed">{opening.impact}</p>
        </div>
      </div>
    </section>

    {/* Section 2: Architectural Deep Dives ("The Ledger") */}
    <section class="reveal mb-24 lg:mb-32">
      <div class="flex items-baseline gap-4 mb-12 border-b-2 border-ink dark:border-dark-ink pb-4">
        <h2 class="font-serif text-4xl md:text-5xl">{ledger.title}</h2>
        <span class="font-mono text-sm text-neutral-500 hidden md:inline-block">{ledger.subtitle}</span>
      </div>

      <div class="space-y-16">
        {/* Case Study 1 */}
        <article class="reveal grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 group">
          <div class="md:col-span-4 lg:col-span-3">
            <span class="font-mono text-xs uppercase tracking-widest text-accent mb-2 block">{evolutionIQ.label}</span>
            <h3 class="font-serif text-3xl md:text-4xl leading-none mb-4 group-hover:text-accent transition-colors duration-300">{evolutionIQ.title}</h3>
          </div>
          <div class="case-body md:col-span-8 lg:col-span-9 font-sans text-base md:text-lg leading-relaxed">
            <EvolutionIQ />
          </div>
        </article>

        <div class="w-full h-px bg-hairline dark:bg-dark-hairline"></div>

        {/* Case Study 2 */}
        <article class="reveal grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 group">
          <div class="md:col-span-4 lg:col-span-3">
            <span class="font-mono text-xs uppercase tracking-widest text-accent mb-2 block">{inference.label}</span>
            <h3 class="font-serif text-3xl md:text-4xl leading-none mb-4 group-hover:text-accent transition-colors duration-300">{inference.title}</h3>
          </div>
          <div class="case-body md:col-span-8 lg:col-span-9 font-sans text-base md:text-lg leading-relaxed">
            <Inference />
          </div>
        </article>

        <div class="w-full h-px bg-hairline dark:bg-dark-hairline"></div>

        {/* Case Study 3 */}
        <article class="reveal grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 group">
          <div class="md:col-span-4 lg:col-span-3">
            <span class="font-mono text-xs uppercase tracking-widest text-accent mb-2 block">{operations.label}</span>
            <h3 class="font-serif text-3xl md:text-4xl leading-none mb-4 group-hover:text-accent transition-colors duration-300">{operations.title}</h3>
          </div>
          <div class="case-body md:col-span-8 lg:col-span-9 font-sans text-base md:text-lg leading-relaxed">
            <Operations />
          </div>
        </article>

      </div>
    </section>

  </main>
</Layout>
