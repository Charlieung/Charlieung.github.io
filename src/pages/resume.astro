---
import Layout from '../layouts/Layout.astro';
import { Content as CareerNote, frontmatter as mechanicalIndex } from '../content/sections/mechanical-index.md';
import { Content as Dispatch, frontmatter as dispatch } from '../content/sections/dispatch.md';

const pdfUrl = '/Charles%20Leung%20-%20Engineering%20Manager%20Resume%202026.pdf';
---

<Layout title="Resume | Charles Leung" description="Resume of Charles Leung, an applied AI engineering leader based in New York.">
	<main class="py-10 md:py-16">
		<header class="reveal grid grid-cols-1 gap-8 border-b-2 border-ink pb-10 dark:border-dark-ink md:grid-cols-12 md:items-end md:gap-12 md:pb-12">
			<div class="md:col-span-8">
				<div class="mb-5 flex items-center gap-3 font-mono text-xs uppercase tracking-widest">
					<span class="text-accent">Resume</span>
					<span aria-hidden="true" class="text-hairline dark:text-dark-hairline">/</span>
					<span lang="zh-Hant" class="text-neutral-500">履歷</span>
				</div>
				<h1 class="font-serif text-7xl leading-none sm:text-8xl md:text-9xl">Resume</h1>
			</div>
			<div class="flex items-end md:col-span-4 md:justify-end">
				<a href={pdfUrl} class="border border-ink px-4 py-3 font-mono text-sm transition-colors duration-200 hover:bg-ink hover:text-paper dark:border-dark-ink dark:hover:bg-dark-ink dark:hover:text-dark-paper">Open PDF ↗</a>
			</div>
		</header>

		<section class="reveal grid grid-cols-1 gap-4 border-b border-hairline py-8 dark:border-dark-hairline md:grid-cols-12 md:gap-12 md:py-10">
			<h2 class="font-mono text-xs uppercase tracking-widest text-accent md:col-span-3">Notes</h2>
			<div class="max-w-3xl text-lg leading-relaxed md:col-span-9 md:text-xl"><CareerNote /></div>
		</section>

		<section class="reveal grid grid-cols-1 gap-8 border-b border-hairline py-10 dark:border-dark-hairline md:grid-cols-12 md:gap-12 md:py-14">
			<h2 class="font-mono text-xs uppercase tracking-widest text-accent md:col-span-3">Experience</h2>
			<div class="divide-y divide-hairline dark:divide-dark-hairline md:col-span-9">
				{mechanicalIndex.experience.map((job: { company: string; role: string; dates: string }) => (
					<article class="grid grid-cols-1 gap-2 py-6 first:pt-0 md:grid-cols-[minmax(0,1fr)_auto] md:gap-8">
						<div>
							<h3 class="font-serif text-3xl">{job.company}</h3>
							<p class="mt-1 text-neutral-600 dark:text-neutral-300">{job.role}</p>
						</div>
						<p class="font-mono text-xs text-neutral-500 md:pt-2">{job.dates}</p>
					</article>
				))}
			</div>
		</section>

		<section class="reveal grid grid-cols-1 gap-8 py-10 md:grid-cols-12 md:gap-12 md:py-14">
			<h2 class="font-mono text-xs uppercase tracking-widest text-accent md:col-span-3">Education</h2>
			<div class="md:col-span-9">
				<h3 class="font-serif text-3xl md:text-4xl">{mechanicalIndex.university}</h3>
				<div class="mt-3 space-y-1 text-neutral-600 dark:text-neutral-300">
					{mechanicalIndex.degrees.map((degree: string) => <p>{degree}</p>)}
				</div>
			</div>
		</section>

		<footer class="reveal grid grid-cols-1 gap-8 border-t-2 border-ink pb-20 pt-10 dark:border-dark-ink md:grid-cols-12 md:gap-12 md:pt-12">
			<div class="md:col-span-3">
				<p class="font-mono text-xs uppercase tracking-widest text-accent">Contact / 聯絡</p>
			</div>
			<div class="md:col-span-9">
				<h2 class="font-serif text-4xl md:text-5xl">{dispatch.title}</h2>
				<div class="mt-4 max-w-2xl text-lg leading-relaxed md:text-xl"><Dispatch /></div>
				<div class="mt-7 flex flex-wrap gap-3 font-mono text-sm">
					<a href={`mailto:${dispatch.email}`} class="border border-hairline px-4 py-2 transition-colors duration-200 hover:bg-ink hover:text-paper dark:border-dark-hairline dark:hover:bg-dark-ink dark:hover:text-dark-paper">{dispatch.email}</a>
					<a href={dispatch.linkedin} target="_blank" rel="noopener noreferrer" class="border border-hairline px-4 py-2 transition-colors duration-200 hover:bg-ink hover:text-paper dark:border-dark-hairline dark:hover:bg-dark-ink dark:hover:text-dark-paper">LinkedIn</a>
					<a href={dispatch.github} target="_blank" rel="noopener noreferrer" class="border border-hairline px-4 py-2 transition-colors duration-200 hover:bg-ink hover:text-paper dark:border-dark-hairline dark:hover:bg-dark-ink dark:hover:text-dark-paper">GitHub</a>
				</div>
			</div>
		</footer>
	</main>
</Layout>
