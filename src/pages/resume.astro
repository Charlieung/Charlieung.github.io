---
import Layout from '../layouts/Layout.astro';

const resumeUrl = '/Charles%20Leung%20-%20Engineering%20Manager%20Resume%202026.pdf';
---

<Layout title="Charles Leung | Resume" description="View or download Charles Leung's engineering management resume.">
  <main class="py-8 md:py-12">
    <nav class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-hairline pb-6 font-mono text-sm dark:border-dark-hairline" aria-label="Resume actions">
      <a href="/" class="hover:text-accent">Back to site</a>
      <a href={resumeUrl} download class="border border-hairline px-4 py-2 hover:bg-ink hover:text-paper dark:border-dark-hairline dark:hover:bg-dark-ink dark:hover:text-dark-paper">Download resume (PDF)</a>
    </nav>
    <h1 class="mb-6 font-serif text-4xl md:text-5xl">Resume</h1>
    <div class="mb-4 flex font-mono text-xs md:hidden" role="group" aria-label="Resume zoom">
      <button id="fit-page" type="button" aria-pressed="true" class="border border-hairline px-3 py-2 dark:border-dark-hairline">Fit page</button>
      <button id="read-size" type="button" aria-pressed="false" class="border border-l-0 border-hairline px-3 py-2 dark:border-dark-hairline">Read size</button>
    </div>
    <p id="resume-status" role="status" class="mb-4 text-sm">Loading resume...</p>
    <div id="resume-pages" data-src={resumeUrl} class="mx-auto flex max-w-[850px] flex-col gap-6 overflow-x-auto" aria-label="Resume pages"></div>
    <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">Can't see the PDF? <a href={resumeUrl} class="underline underline-offset-4">Open the resume directly</a>.</p>
  </main>
</Layout>

<script>
  import { getDocument, GlobalWorkerOptions } from 'pdfjs-dist';
  import workerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';

  const pages = document.querySelector<HTMLElement>('#resume-pages');
  const status = document.querySelector<HTMLElement>('#resume-status');
  const fitButton = document.querySelector<HTMLButtonElement>('#fit-page');
  const readButton = document.querySelector<HTMLButtonElement>('#read-size');

  function setReadSize(enabled: boolean) {
    if (!pages || !fitButton || !readButton) return;
    pages.querySelectorAll('canvas').forEach((canvas) => {
      canvas.style.width = enabled ? '700px' : '100%';
    });
    fitButton.setAttribute('aria-pressed', String(!enabled));
    readButton.setAttribute('aria-pressed', String(enabled));
  }

  fitButton?.addEventListener('click', () => setReadSize(false));
  readButton?.addEventListener('click', () => setReadSize(true));

  async function renderResume() {
    if (!pages || !status || !pages.dataset.src) return;

    GlobalWorkerOptions.workerSrc = workerUrl;
    try {
      const pdf = await getDocument({ url: pages.dataset.src }).promise;
      for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber++) {
        const page = await pdf.getPage(pageNumber);
        const baseViewport = page.getViewport({ scale: 1 });
        const scale = (850 / baseViewport.width) * Math.min(devicePixelRatio, 2);
        const viewport = page.getViewport({ scale });
        const canvas = document.createElement('canvas');
        const context = canvas.getContext('2d');
        if (!context) throw new Error('Canvas is unavailable');

        canvas.width = Math.ceil(viewport.width);
        canvas.height = Math.ceil(viewport.height);
        canvas.className = 'w-full h-auto bg-white shadow-sm';
        canvas.setAttribute('role', 'img');
        canvas.setAttribute('aria-label', `Resume page ${pageNumber} of ${pdf.numPages}`);
        pages.append(canvas);
        await page.render({ canvas, canvasContext: context, viewport }).promise;
      }
      status.remove();
    } catch (error) {
      console.error('Resume preview failed:', error);
      status.textContent = 'Preview unavailable. Use the PDF link below to open the resume.';
    }
  }

  renderResume();
</script>
